  npcPortrait: {fileID: 7482667652216324306, guid: 48e93eef0688c4a259cb0eddcd8661f7, type: 3}
  dialogueLines:
  - "\xDCDV \xDAJRA MISI!"
  - "HOGY MIT KERESEK ITT? CSAK A SZOK\xC1SOS - A KIR\xC1LYS\xC1G FEL\xC9 TARTOK."
  - "HA TE IS ARRA M\xC9SZ, ELN\xC9Z\xC9ST K\xC9REK HOGY NEM SZ\xD3LTAM."
  - "SAJNOS SOK DOLGOM VAN, SZ\xD3VAL CSAK N\xC9HA-N\xC9HA TUDOK MEGJELENNI!"
  - "DE L\xC1TOM EGYRE \xDCGYESEBB VAGY!"
  - "NEM CSAK UGR\xC1S SZINTEN, HAHA. A SZAVAKAT IS EGYRE JOBBAN TUDOD!"
  - "VAJON MENNYIRE LESZEL PROFI UTAD V\xC9G\xC9RE?"
  - "IZGATOTTAN V\xC1ROM!"
  endDialogueLines: 0000000000000001
