  npcName: BAGOLY
  dialogueLines:
  - "MISI, L\xC1TOM EGYRE JOBB \xC9S JOBB VAGY!"
  - "NEMSOK\xC1RA EL\xC9RKEZ\xDCNK A KIR\xC1LYS\xC1GBA! L\xC9GY B\xDCSZKE MAGADRA!"
  - "MIT SZ\xD3LSZ EGY GYORS K\xC9RD\xC9SHEZ? SZERINTED MILYEN \"J\xC9\" AZ \"ELFOJT\"?"
  - "HAHA, J\xD3 V\xC1LASZ!"
  - "UGYANIS AZ \"ELFOJT\" \xC9S AZ \"ELFOLYT\" IS HELYES ALAK!"
  - "TERM\xC9SZETESEN JELENT\xC9S\xDCK M\xC1S, DE MINDKETT\u0150 L\xC9TEZIK!"
  - "EBBE A MONDATBA SZERINTED MELYIK ILLIK: \"ELFO_TJA AZ \xC9RZ\xC9SEIT\"?"
  - "HELYES V\xC1LASZ! LY-NAL P\xC9LDA LEHETNE EZ A MONDAT: \"A CSATORN\xC1B\xD3L
    A V\xCDZ M\xC1R R\xC9G ELFOLYT.\""
  - "NA, NEM TARTALAK FEL megint. TOV\xC1BBI J\xD3 UTAT, BAR\xC1TOM!"
  - "HMM, ESK\xDCDNI MERN\xC9K, HOGY M\xC1R TAL\xC1LKOZT\xC1L EZZEL A SZ\xD3VAL AZ
    ES\u0150ERD\u0150BEN..."
  - "DE NE CS\xDCGGEDJ! MINDENKI HIB\xC1ZIK, EZ TERM\xC9SZETES. \xC9S A HIB\xC1KB\xD3L
    CSAK TANULNI LEHET!"
  - "TOV\xC1BBI SOK SIKERT UTADON, MISI! NEMSOK\xC1RA TAL\xC1LKOZUNK!"
  endDialogueLines: 000000000000000001000001
